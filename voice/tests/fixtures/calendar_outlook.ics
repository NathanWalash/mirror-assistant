BEGIN:VCALENDAR
METHOD:PUBLISH
PRODID:Microsoft Exchange Server 2010
VERSION:2.0
X-WR-CALNAME:Calendar
BEGIN:VTIMEZONE
TZID:GMT Standard Time
BEGIN:STANDARD
DTSTART:16010101T020000
TZOFFSETFROM:+0100
TZOFFSETTO:+0000
RRULE:FREQ=YEARLY;INTERVAL=1;BYDAY=-1SU;BYMONTH=10
END:STANDARD
BEGIN:DAYLIGHT
DTSTART:16010101T010000
TZOFFSETFROM:+0000
TZOFFSETTO:+0100
RRULE:FREQ=YEARLY;INTERVAL=1;BYDAY=-1SU;BYMONTH=3
END:DAYLIGHT
END:VTIMEZONE
BEGIN:VEVENT
UID:football@example.com
SUMMARY;LANGUAGE=en-GB:Five-a-side
DTSTART;TZID=GMT Standard Time:20260915T190000
DTEND;TZID=GMT Standard Time:20260915T203000
RRULE:FREQ=WEEKLY;INTERVAL=1;BYDAY=TU
END:VEVENT
BEGIN:VEVENT
UID:flat-dinner-b@example.com
SUMMARY;LANGUAGE=en-GB:Flat dinner
DTSTART;TZID=GMT Standard Time:20261111T190000
DTEND;TZID=GMT Standard Time:20261111T210000
END:VEVENT
BEGIN:VEVENT
UID:trip@example.com
SUMMARY;LANGUAGE=en-GB:Trip to Manchester
DTSTART;VALUE=DATE:20261112
DTEND;VALUE=DATE:20261115
X-MICROSOFT-CDO-ALLDAYEVENT:TRUE
END:VEVENT
BEGIN:VEVENT
UID:maybe-drinks@example.com
SUMMARY;LANGUAGE=en-GB:Leaving drinks
DTSTART;TZID=GMT Standard Time:20261113T180000
DTEND;TZID=GMT Standard Time:20261113T200000
X-MICROSOFT-CDO-BUSYSTATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:late-shift@example.com
SUMMARY;LANGUAGE=en-GB:Late shift
DTSTART;TZID=GMT Standard Time:20261109T220000
DTEND;TZID=GMT Standard Time:20261110T090000
END:VEVENT
END:VCALENDAR
